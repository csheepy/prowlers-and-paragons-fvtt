{{! This template is a fallback for when items don't have more specific templates. }}
{{! Generally, you'll want to make more specific templates when possible. }}
<form class='{{cssClass}}' autocomplete='off'>
  <header class='sheet-header'>
    <img
      class='profile-img'
      src='{{item.img}}'
      data-edit='img'
      title='{{item.name}}'
    />
    <div class='header-fields'>
      <h2 class='kind' style='text-transform: uppercase;'><strong>{{system.kind}}</strong></h2>
      <h1 class='charname'><input
          name='name'
          type='text'
          value='{{item.name}}'
          placeholder='Name'
        /></h1>
      <div class="resource flex-group-center flex-column">
        <h4 class="cost">{{localize "PROWLERS_AND_PARAGONS.Item.Procon.cost"}}: <strong>{{system.cost_flat}}</strong> flat | <strong>{{system.cost_per_rank}}</strong>/rank </h4>
      </div>
    </div>
  </header>

  {{! Sheet Tab Navigation }}
  <nav class='sheet-tabs tabs' data-group='primary'>
    <a class='item' data-tab='description'>Description</a>
    <a class='item' data-tab='attributes'>Attributes</a>
  </nav>

  {{! Sheet Body }}
  <section class='sheet-body'>

    {{! Description Tab }}
    <div class='tab' data-group='primary' data-tab='description'>
      {{! Editors must receive enriched text data from getData to properly handle rolls }}
      {{editor
        enrichedDescription
        target='system.description'
        engine='prosemirror'
        button=true
        editable=editable
      }}
    </div>

    {{! Attributes Tab }}
    <div class='tab attributes' data-group='primary' data-tab='attributes'>
        <div class='resource'>
            <label class='resource-label'>{{localize "PROWLERS_AND_PARAGONS.Item.Procon.cost-flat"}}</label>
            <input
                type='text'
                name='system.cost_flat'
                value='{{system.cost_flat}}'
                data-dtype='Number'
                />
       </div>
        <div class='resource'>
            <label class='resource-label'>{{localize "PROWLERS_AND_PARAGONS.Item.Procon.cost-per-rank"}}</label>
            <input
                type='text'
                name='system.cost_per_rank'
                value='{{system.cost_per_rank}}'
                data-dtype='Number'
                />
        </div>
        <div class='resource'>
            <label class='resource-label'>{{localize "PROWLERS_AND_PARAGONS.Item.Procon.kind"}}</label>
            <select name='system.kind'>
                {{selectOptions pro_con_choices selected=system.kind}}
            </select>
        </div>
    </div>
  </section>
</form>